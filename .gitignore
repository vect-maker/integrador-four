# ==============================================================================
# Node.js / Vite (Presentación en slides/)
# ==============================================================================
node_modules/
dist/
.frontend-slides/

# ==============================================================================
# Typst (Documentación en document/)
# ==============================================================================
# Ignorar los PDFs compilados para no inflar el historial de Git con binarios
*.pdf

# Ignorar archivos SVG y PNG pesados autogenerados para evitar contaminar el historial
typst/graphs/*.svg
typst/graphs/*.png

# Caché y artefactos del Language Server de Typst (Tinymist)
.tinymist/
*.preview.html

# ==============================================================================
# Sistema Operativo y Logs
# ==============================================================================
.DS_Store
Thumbs.db
*.log

# ==============================================================================
# Pipeline ELT (Python & dbt)
# ==============================================================================
.venv/
*/.venv/
__pycache__/
*/__pycache__/
*.py[cod]
.env
pipeline/data/raw/*.parquet
pipeline/dbt/target/
pipeline/dbt/dbt_packages/
pipeline/dbt/logs/
pipeline/dbt/.user.yml

# ==============================================================================
# DuckDB (Bases de datos locales y snapshots analíticos)
# ==============================================================================
*.duckdb
*.duckdb.wal
*.duckdb.tmp
pipeline/data/*.duckdb
data/*.duckdb
pipeline/data/.osm_tile_cache/

