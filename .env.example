# REST API Endpoint Configuration (Required by fetcher)
# Local simulation server: http://localhost:8000/movigo
# Remote simulation server: http://20.228.134.116:8000/movigo
API_URL=http://localhost:8000/movigo

# PostgreSQL Database Connection Configuration
# Used by dbt and Python loader/fetcher
PGHOST=your-db-server.postgres.database.azure.com
PGPORT=5432
PGUSER=your-db-username
PGPASSWORD=your-db-password
PGDATABASE=postgres
PGSCHEMA=analytics
PGSSLMODE=require
PGADMIN_DATABASE=postgres
RAW_DB_NAME=postgres
RAW_SCHEMA=raw
